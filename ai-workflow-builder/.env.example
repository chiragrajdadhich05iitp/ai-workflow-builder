# ============================================================
# NextFlow — Environment Variables
# Copy this to .env.local and fill in each value.
# ============================================================

# ── Clerk Auth ──────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Neon Postgres ───────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/dbname?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:pass@host/dbname

# ── Trigger.dev ─────────────────────────────────────────────
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_SECRET_KEY=tr_sk_REPLACE_ME
TRIGGER_PROJECT_REF=proj_REPLACE_ME   # found in Trigger.dev dashboard → Project Settings

# ── Google AI (Gemini) ──────────────────────────────────────
GOOGLE_AI_API_KEY=REPLACE_ME

# ── Transloadit ─────────────────────────────────────────────
TRANSLOADIT_AUTH_KEY=REPLACE_ME
TRANSLOADIT_AUTH_SECRET=REPLACE_ME
TRANSLOADIT_TEMPLATE_ID_UPLOAD=REPLACE_ME

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CANDIDATE_LINKEDIN=https://www.linkedin.com/in/sameergupta533/

NEXTAUTH_SECRET="chirag-secret-key-12345"
NEXTAUTH_URL="http://localhost:3000"